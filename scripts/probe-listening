#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
[[ -n ${IN_NIX_SHELL:-} ]] || { echo 'Requires nix develop' >&2; exit 2; }
[[ $# == 1 && -f $1 ]] || { echo 'Usage: scripts/probe-listening audio.wav' >&2; exit 2; }
python3 scripts/audio-measure.py "$1"
llama-mtmd-cli --list-devices | grep 'CUDA0' || { echo 'CUDA0 is required; no CPU fallback' >&2; exit 2; }
model_path=$(nix build --no-update-lock-file --no-link --print-out-paths .#audio-review-model-v3)
projector_path=$(nix build --no-update-lock-file --no-link --print-out-paths .#audio-review-projector-v3)
llama-mtmd-cli -m "$model_path" --mmproj "$projector_path" \
  --jinja --device CUDA0 -ngl auto --fit on --fit-target 6144 --mmproj-offload \
  --verbosity 4 \
  -t 8 -c 8192 -n 256 --temp 0 --seed 1 \
  --audio "$1" \
  -p 'Listen to the entire clip. Describe the audible sequence, its texture, attack and decay, pauses or repetitions, and any distortion or intelligible speech. If uncertain about a source, describe its acoustic qualities rather than guessing. Do not infer content from the filename.'
